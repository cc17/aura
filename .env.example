# 豆包 (Doubao) API Key
AURA_ARK_API_KEY=xxx

# Default model
AURA_DEFAULT_MODEL=openai/doubao-1-5-pro-32k-250115

# Serper API Key (for job search)
AURA_SERPER_API_KEY=your-serper-api-key

# Database (PostgreSQL + pgvector, see docs/SETUP.md)
AURA_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aura

# Auth (random string, used for JWT signing)
AURA_SECRET_KEY=change-me-to-a-random-secret

# Server
AURA_HOST=0.0.0.0
AURA_PORT=8000
AURA_DEBUG=true
